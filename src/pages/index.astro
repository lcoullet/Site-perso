---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import BlogCard from "../components/BlogCard.astro";

// Fetch the 3 latest non-draft posts
const posts = await getCollection("blog", ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
});

const latestPosts = posts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
---

<Layout>
    <main
        id="main-content"
        class="container mx-auto px-6 py-20 max-w-3xl focus:outline-none"
        tabindex="-1"
    >
        <article class="flex flex-col gap-6">
            <h1
                class="text-4xl sm:text-5xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50"
            >
                Salut !
            </h1>

            <div class="text-lg text-zinc-600 dark:text-zinc-400 space-y-4 leading-relaxed">
                <p>
                    C'est <strong class="font-semibold text-zinc-900 dark:text-zinc-50"
                        >Ludovic Coullet</strong
                    >.
                </p>

                <div class="text-zinc-600 dark:text-zinc-400 space-y-6 leading-relaxed">
                    <p>
                        Responsable technique et ingénieur avant-vente
                        spécialisé dans l'open source et plus particulièrement
                        Drupal, je conçois depuis plus de 20 ans des solutions
                        numériques complexes, accessibles et éco-conçues.
                        Curieux de nature et passionné par les structures
                        complexes, je transpose cette rigueur technique dans le
                        champ de la création artistique en tant que compositeur
                        de musique électroacoustique et acousmatique. Ce site
                        personnel est le point de convergence de mes
                        explorations numériques et sonores.
                    </p>
                </div>
            </div>

            <div id="home-cta" class="flex flex-wrap items-center gap-3 pt-2">
                <a
                    href="/blog"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-50 dark:hover:bg-zinc-200 text-white dark:text-zinc-950 text-sm font-semibold shadow-sm transition-all focus-ring-custom"
                >
                    <span>Lire le blog</span>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        class="w-4 h-4"
                        aria-hidden="true"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                        />
                    </svg>
                </a>
                <a
                    href="/soundcloud"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-800 text-sm font-semibold shadow-sm transition-all focus-ring-custom"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        class="w-4 h-4 text-zinc-500 dark:text-zinc-400"
                        aria-hidden="true"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 9l10.5-3m0 0v1.5m0-1.5L9 12m10.5-6v12.75A2.25 2.25 0 0117.25 21c-1.242 0-2.25-1.008-2.25-2.25s1.008-2.25 2.25-2.25a2.25 2.25 0 012.25 2.25V5.25zM9 12v6.75A2.25 2.25 0 016.75 21c-1.242 0-2.25-1.008-2.25-2.25S5.508 16.5 6.75 16.5A2.25 2.25 0 019 18.75V12z"
                        />
                    </svg>
                    <span>Écouter mes créations</span>
                </a>
            </div>
        </article>

        {
            latestPosts.length > 0 && (
                <section class="mt-20 border-t border-zinc-200/80 dark:border-zinc-800 pt-16">
                    <div class="flex items-center justify-between mb-8">
                        <h2 class="text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
                            Derniers articles
                        </h2>
                        <a
                            href="/blog"
                            class="text-sm font-semibold text-zinc-900 dark:text-zinc-50 hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors inline-flex items-center gap-1 group focus-ring-custom rounded-lg"
                        >
                            Tous les articles
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                class="w-4 h-4 group-hover:translate-x-0.5 transition-transform"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                                />
                            </svg>
                        </a>
                    </div>

                    <div class="flex flex-col gap-6">
                        {latestPosts.map((post) => (
                            <BlogCard post={post} />
                        ))}
                    </div>
                </section>
            )
        }
    </main>
</Layout>
