---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page non trouvée (404) | Ludovic Coullet"
  description="La page que vous recherchez n'existe pas ou a été déplacée."
>
  <main
    id="main-content"
    class="flex-grow container mx-auto px-6 py-20 md:py-28 max-w-2xl flex flex-col items-center justify-center text-center focus:outline-none"
    tabindex="-1"
  >
    <div class="animate-fade-in space-y-6">
      <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold tracking-widest uppercase bg-zinc-100 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-800">
        Erreur 404
      </span>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-zinc-950 dark:text-zinc-50">
        Page introuvable
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-lg mx-auto">
        La page que vous recherchez n'existe pas, a été déplacée ou n'est plus disponible.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-50 dark:hover:bg-zinc-200 text-white dark:text-zinc-950 text-sm font-semibold shadow-sm transition-all focus-ring-custom"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-4 h-4"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"
            />
          </svg>
          <span>Retour à l'accueil</span>
        </a>

        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-800 text-sm font-semibold shadow-sm transition-all focus-ring-custom"
        >
          <span>Parcourir le blog</span>
        </a>

        <a
          href="/soundcloud"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-800 text-sm font-semibold shadow-sm transition-all focus-ring-custom"
        >
          <span>Écouter la musique</span>
        </a>
      </div>
    </div>
  </main>
</Layout>
